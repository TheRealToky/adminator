# ══════════════════════════════════════════════════════════════════════════
#  Adminator — environment configuration
#  Copy to .env and adjust for your environment.
# ══════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_DB=adminator
POSTGRES_USER=adminator
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Django backend ────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=django-insecure-replace-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Default admin user (created by seed) ──────────────────────────────────
DJANGO_SUPERUSER_EMAIL=admin@adminator.local
DJANGO_SUPERUSER_PASSWORD=admin12345
DJANGO_SUPERUSER_FULL_NAME=Site Admin

# ── Business / locale defaults ────────────────────────────────────────────
BUSINESS_NAME=Sweet Hills Bakery
BUSINESS_CURRENCY=RWF
BUSINESS_CURRENCY_SYMBOL=FRw
BUSINESS_TIMEZONE=Africa/Kigali
BUSINESS_LOCALE=en-RW

# ── Frontend (Vite reads VITE_* at build time) ────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Adminator

# ── JupyterLab ────────────────────────────────────────────────────────────
JUPYTER_TOKEN=adminator-lab
